{
  "name": "yangi-ozbek-alifbo",
  "version": "1.0.0",
  "private": true,
  "description": "Yangi (2026) özbek lotin alifbosi klaviaturasi va ögirgiçi: sh → ş, ch → ç, o' → ö, g' → ğ",
  "license": "MIT",
  "scripts": {
    "build": "kmc --no-error-reporting build keyman/yangi_ozbek/yangi_ozbek.kpj && node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('keyman/yangi_ozbek/build/yangi_ozbek.kmp','dist/yangi_ozbek.kmp')\"",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@keymanapp/kmc": "18.0.254"
  }
}
