# @BotFather dan olingan token
BOT_TOKEN=1234567890:AAAA-bu-yerga-o'z-tokeningizni-qo'ying

# Kurs koordinatorlari Telegram ID raqamlari, vergul bilan (ID ni @userinfobot orqali bilish mumkin)
# Super-admin(lar): barcha kurslarni bot ichidan boshqaradi — kurs va kurs koordinatori qo'shish/olib tashlash
# (serverga kirish va qayta ishga tushirish shart emas), barcha kurslar holati, zaxira nusxa, xatolar jurnali.
# Xavfsizlik uchun faqat shu yerda belgilanadi.
SUPERADMIN_IDS=

ADMIN_IDS=123456789

# Kurs koordinatorlari. ADMIN_IDS va KURSLAR — faqat boshlang'ich sozlama: bot birinchi ishga tushganda
# umumiy ro'yxatga yoziladi, keyin kurs va koordinatorlar super-admin tomonidan bot ichidan boshqariladi
# (bot ichidan olib tashlangan koordinator bu yerda qolsa ham qayta qo'shilmaydi).
# Bir nechta kurs koordinatori — har birining kursi uchun alohida data papka va ma'lumotlar bazasi
# (data/<kurs>/bot.db). Format: kurs:ID,ID;kurs:ID. Bitta kursni bir necha koordinator birga yuritishi mumkin.
# KURSLAR ga yozilmagan ADMIN_IDS koordinatorlarining har biri o'z kursini oladi: data/koordinator_<ID>/.
# Bo'sh qolsa — ADMIN_IDS dagi har bir koordinator alohida kurs.
KURSLAR=
# Kurslar papkalari joylashadigan asosiy papka
DATA_DIR=data

UNIVERSITY_NAME=Jahon iqtisodiyoti va diplomatiya universiteti
TIMEZONE=Asia/Tashkent

# Semestr boshlanishi (YYYY-MM-DD): semestr statistikasi va toq/juft haftalar uchun
SEMESTER_START=2026-09-01

# Kunlik xulosa vaqti va qaysi kun uchun (0 - shu kun, 1 - kechagi kun)
DAILY_DIGEST_TIME=19:00
DIGEST_DAY_OFFSET=0

# Shundan eski qoldirilgan darslar uchun darhol xabar yuborilmaydi
NOTIFY_MAX_AGE_DAYS=3

# Dars qoldirish chegaralari (semestr davomida, soat) va har biriga mos chora — universitet ichki tartibi.
# Ota-onaga har bir chegara o'tilganda bir marta xabar boradi, kurs koordinatoriga — ro'yxat (/chegaralar).
ABSENCE_WARN_LEVELS=18,36,54,74
ABSENCE_WARN_ACTIONS=Dekan nomiga tushuntirish xati|Dekan ogohlantirishi|Hayfsan|Talabalar safidan chetlatish
# 0 — chegaralarga faqat sababsiz qoldirilgan soatlar hisoblanadi; 1 — sababli soatlar ham qo'shiladi
ABSENCE_COUNT_EXCUSED=0
# HEMIS «darslarga qatnashish statistikasi»dagi sonlar — juftlik (para): 1 para = 2 soat.
# Ota-onaga va kurs koordinatoriga «5 para (10 soat)» ko'rinishida ko'rsatiladi. Sonlar soatda bo'lsa — 1.
HEMIS_STATS_HOURS_PER_UNIT=2
# Bitta fandan sababsiz qoldirilgan darslar ulushi (%) shundan oshsa — ogohlantirish
SUBJECT_WARN_PERCENT=25
# Kursdan kursga o'tish uchun eng kam umumiy GPA (yaxlitlanmaydi: 2,59 — o'tmaydi)
GPA_MIN=2.6
SUBJECT_WARN_MIN_LESSONS=4

# Faylda "Soat" ustuni bo'lmasa bitta juftlik necha soat hisoblanadi
HOURS_PER_PAIR=2

# Juftlik vaqtlari (jadval faylida vaqt yo'q bo'lsa). Rasmiy qo'ng'iroq jadvali bo'yicha to'ldiring:
# PAIR_TIMES=1=08:30-09:50;2=10:00-11:20;3=11:30-12:50
PAIR_TIMES=

# Eski (bitta bazali) versiyaning bazasi: bot birinchi ishga tushganda birinchi kursning papkasiga ko'chiriladi
DB_PATH=data/bot.db

# To'lov muddatidan necha kun oldin qarzdorlarning ota-onalariga eslatma yuboriladi va qaysi vaqtda
# (muddatning o'zi botda belgilanadi: /muddat kontrakt 30.09.2026)
PAY_REMIND_DAYS=7,3,1
PAY_REMIND_TIME=10:00

# Zaxira nusxa: har kuni shu vaqtda barcha kurs bazalari va central.db — bitta arxivga (backups/), super-adminga yuboriladi
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14
# Parol bo'lsa — arxiv AES-256 bilan shifrlanadi (tavsiya etiladi: unda talabalarning shaxsiy ma'lumotlari bor).
# Arxivni 7-Zip yoki WinRAR bilan shu parol orqali ochish mumkin.
BACKUP_PASSWORD=
# 0 — arxiv Telegram orqali yuborilmaydi (faqat serverda saqlanadi, super-adminga hisobot boradi)
BACKUP_SEND=1

# Loglar: logs/bot.log va logs/errors.log; tizim xatolari super-adminga darhol yuboriladi
LOG_DIR=logs
# Bir xil xato haqida xabar — shuncha daqiqada bir martadan ko'p emas
ALERT_COOLDOWN_MIN=10

# ---------------------------------------------------------------- Telegram Web App (ilova)
# Ilovaning ochiq HTTPS manzili (oxirida / belgisiz). Bo'sh qolsa — ilova o'chiq, bot odatdagidek ishlaydi.
# Manzil berilganda bot o'zi: chat menyusiga «📱 Ilova» tugmasini, ota-ona bosh menyusiga «📱 Ilovani ochish»
# tugmasini va har bir bildirishnoma ostiga «📱 Ilovada ochish» tugmasini qo'shadi.
# Telegram ilovani faqat HTTPS orqali ochadi — README, «Web App uchun HTTPS manzil» bo'limi.
# WEBAPP_URL=https://ilova.example.uz
WEBAPP_URL=
# Telefon ilovasi: yangi Android APK shu GitHub repodagi so'nggi relizdan avtomatik olinadi (bo'sh — o'chiq)
APP_RELEASES_REPO=egamberdievnodirjon030-ops/farzandim
# Ichki veb-server: tashqi dunyoga to'g'ridan-to'g'ri ochilmaydi, unga Caddy/nginx yoki Cloudflare Tunnel ulanadi
WEBAPP_HOST=127.0.0.1
# 0 — veb-server ishga tushmaydi
WEBAPP_PORT=8080
# Telegram imzosi (initData) necha soniya amal qiladi; muddati o'tsa ilova qayta ochiladi
WEBAPP_AUTH_TTL=86400
# FAQAT sinov uchun: brauzerda Telegram'siz ochish (?dev=1) — shu Telegram ID nomidan. Serverda bo'sh qoldiring!
WEBAPP_DEV_USER=
# Ilova rejimi: WEBAPP_URL sozlangan bo'lsa bot faqat ilovani ochadi va qisqa bildirishnomalar yuboradi.
# Botning to'liq menyulari (eski ko'rinish) kerak bo'lsa: BOT_FULL_MENU=1
BOT_FULL_MENU=
