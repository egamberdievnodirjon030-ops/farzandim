# =====================================================================
#  Shahar Taksi — sozlamalar. Ushbu faylni .env nomi bilan nusxalang.
# =====================================================================

# --- Botlar (@BotFather dan oling) -----------------------------------
# Ikki bot rejimi (tavsiya etiladi): yo'lovchilar va haydovchilar uchun alohida botlar.
PASSENGER_BOT_TOKEN=123456:yolovchi-boti-tokeni
DRIVER_BOT_TOKEN=654321:haydovchi-boti-tokeni
# DRIVER_BOT_TOKEN bo'sh qoldirilsa — bitta bot rejimi: kirishda "Yo'lovchi / Haydovchi" so'raladi.

# Adminlar Telegram ID lari (vergul bilan). Ular haydovchi arizalarini tasdiqlaydi.
ADMIN_IDS=111111111
# Arizalar va aloqa so'rovlari yuboriladigan dispetcherlik guruhi (ixtiyoriy).
# Guruhga HAYDOVCHI botini qo'shing. Bo'sh bo'lsa — ADMIN_IDS ga yuboriladi.
ADMIN_CHAT_ID=

COMPANY_NAME=Shahar Taksi
COMPANY_PHONE=+998712000000
CURRENCY=so'm

# --- Ma'lumotlar bazasi ----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/taxi.db
# PostgreSQL (katta yuklama uchun): postgresql+asyncpg://taxi:taxi@postgres:5432/taxi
# REDIS_URL=redis://redis:6379/0

# --- Tarif ------------------------------------------------------------
BASE_FARE=7000          # o'tirish narxi (BASE_KM ichida)
BASE_KM=2
PER_KM=2000
FREE_WAIT_MIN=3         # bepul kutish (daqiqa)
PER_WAIT_MIN=500        # keyingi har bir to'liq daqiqa
MIN_FARE=7000
PRICE_ROUND=500
COMMISSION_PERCENT=10   # har bir safardan haydovchi balansidan yechiladi
MIN_DRIVER_BALANCE=1000 # shundan kam balansda buyurtma kelmaydi
WELCOME_BONUS=0         # yangi tasdiqlangan haydovchiga bonus

# --- Qidiruv ----------------------------------------------------------
WAVE_RADII_KM=1,2,3.5,5,8     # diapazonlar (to'lqinlar)
WAVE_TIMEOUT_SEC=60           # har bir diapazonda kutish (1 daqiqa)
SEARCH_TIMEOUT_SEC=420        # umumiy qidiruv vaqti
RESCAN_INTERVAL_SEC=15        # yangi bo'shagan haydovchilarni tekshirish oralig'i
PRIORITY_RATING=4.8           # shu reytingdan yuqorilar birinchi ko'radi
PRIORITY_HEADSTART_SEC=10     # ularning ustunlik vaqti
ROAD_FACTOR=1.3
CITY_SPEED_KMH=25
# Haqiqiy yo'llar bo'yicha aniq masofa/vaqt uchun OSRM (README ga qarang):
# OSRM_URL=http://osrm:5000

# --- Joylashuv --------------------------------------------------------
REQUIRE_LIVE_LOCATION=true    # haydovchilar faqat jonli joylashuv bilan liniyaga chiqadi
STATIC_LOCATION_TTL_MIN=10
LIVE_LOCATION_IDLE_TTL_MIN=30

# --- Safar ------------------------------------------------------------
FINISH_CONFIRM_TIMEOUT_MIN=10 # yo'lovchi javob bermasa avtomatik yakunlash (0 = o'chirilgan)
NO_SHOW_WAIT_MIN=5

# --- Aloqa (kompaniya raqami orqali, raqamlar yashirin) ---------------
# none | operator | zadarma | webhook
CALL_PROVIDER=operator
# Zadarma: callback — avval tugmani bosganga, keyin ikkinchi tomonga kompaniya raqamidan qo'ng'iroq
# ZADARMA_KEY=
# ZADARMA_SECRET=
# ZADARMA_SIP=100
# O'z ATS (Asterisk, OnlinePBX...) uchun: {"order_id","first","second"} JSON POST qilinadi
# CALL_WEBHOOK_URL=https://pbx.example.uz/callback
# CALL_WEBHOOK_SECRET=

# --- Balansni to'ldirish ----------------------------------------------
# @BotFather -> Payments -> Click yoki Payme -> provider token (haydovchi botiga)
# PAYMENT_PROVIDER_TOKEN=
TOPUP_AMOUNTS=20000,50000,100000
PAYMENT_INSTRUCTIONS=Balansni to'ldirish uchun operatorga murojaat qiling va ID raqamingizni yuboring.

# --- Interfeys --------------------------------------------------------
RICH_MESSAGES=true     # Rich Message kartalari (xarita bloki bilan); eski ilovalar uchun avtomatik zaxira
MESSAGE_EFFECTS=true   # safar yakunida 🎉 effekti
# Tugmalarda custom emoji (bot egasida Telegram Premium bo'lishi kerak):
# BUTTON_EMOJI_IDS={"taxi": "5368324170671202286", "pin": "5391032818111363540"}

LOG_LEVEL=INFO
