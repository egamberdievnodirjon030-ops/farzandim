# =====================================================================
#  Shahar Taksi — sozlamalar. Ushbu faylni .env nomi bilan nusxalang.
# =====================================================================

# --- Botlar (@BotFather dan oling) -----------------------------------
# Asosiy bot tokeni (bitta botingiz bo'lsa — faqat shuni yozing).
PASSENGER_BOT_TOKEN=
# Ikkinchi (haydovchilar) boti tokeni. Bo'sh qoldirilsa — bitta bot rejimi:
# kirishda "Yo'lovchi / Haydovchi" so'raladi. Ikki bot uchun shu yerga ikkinchi tokenni yozing.
DRIVER_BOT_TOKEN=

# Adminlar Telegram ID lari (vergul bilan). Ular haydovchi arizalarini tasdiqlaydi.
# O'z ID'ingizni @userinfobot dan bilib oling. Admin botda avval /start bosishi kerak.
ADMIN_IDS=
# Arizalar va aloqa so'rovlari yuboriladigan dispetcherlik guruhi (ixtiyoriy).
# Guruhga HAYDOVCHI botini qo'shing. Bo'sh bo'lsa — ADMIN_IDS ga yuboriladi.
ADMIN_CHAT_ID=

COMPANY_NAME=Shahar Taksi
COMPANY_PHONE=+998712000000
CURRENCY=so'm

# --- Ma'lumotlar bazasi ----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/taxi.db
# PostgreSQL (katta yuklama uchun): postgresql+asyncpg://taxi:taxi@postgres:5432/taxi
# REDIS_URL=redis://redis:6379/0

# --- Tarif ------------------------------------------------------------
# o'tirish narxi (BASE_KM ichida)
BASE_FARE=7000
BASE_KM=2
PER_KM=2000
# bepul kutish (daqiqa)
FREE_WAIT_MIN=3
# keyingi har bir to'liq daqiqa
PER_WAIT_MIN=500
MIN_FARE=7000
PRICE_ROUND=500
# har bir safardan haydovchi balansidan yechiladi
COMMISSION_PERCENT=10
# shundan kam balansda buyurtma kelmaydi
MIN_DRIVER_BALANCE=1000
# yangi haydovchiga tasdiqlanganda bir martalik bonus (so'm)
WELCOME_BONUS=30000
# 0 — barcha yangi haydovchilarga; masalan 50 — faqat birinchi 50 ta haydovchiga
WELCOME_BONUS_LIMIT=0

# --- Qidiruv ----------------------------------------------------------
# diapazonlar (to'lqinlar)
WAVE_RADII_KM=1,2,3.5,5,8
# har bir diapazonda kutish (1 daqiqa)
WAVE_TIMEOUT_SEC=60
# umumiy qidiruv vaqti
SEARCH_TIMEOUT_SEC=420
# yangi bo'shagan haydovchilarni tekshirish oralig'i
RESCAN_INTERVAL_SEC=15
# shu reytingdan yuqorilar birinchi ko'radi
PRIORITY_RATING=4.8
# ularning ustunlik vaqti
PRIORITY_HEADSTART_SEC=10
ROAD_FACTOR=1.3
CITY_SPEED_KMH=25
# ❤️ Sevimli haydovchi shu radiusda bo'lsa, buyurtmani boshqalardan oldin ko'radi
FAVORITE_RADIUS_KM=3
FAVORITE_HEADSTART_SEC=10
# 🏡 "Uyga" rejimi: safar haydovchini uyiga kamida shuncha (0.25 = 25%) yaqinlashtirishi kerak
HOME_MODE_MIN_GAIN=0.25
# Haqiqiy yo'llar bo'yicha aniq masofa/vaqt uchun o'z OSRM serveringiz (README ga qarang):
# OSRM_URL=http://osrm:5000
# Marshrut chizig'i va narx uchun ommaviy OSRM serverlari (standart). O'chirish: ROUTE_URLS=none
# ROUTE_URLS=https://routing.openstreetmap.de/routed-car,https://router.project-osrm.org

# --- Joylashuv --------------------------------------------------------
# haydovchilar faqat jonli joylashuv bilan liniyaga chiqadi
REQUIRE_LIVE_LOCATION=true
STATIC_LOCATION_TTL_MIN=10
LIVE_LOCATION_IDLE_TTL_MIN=30

# --- Safar ------------------------------------------------------------
# Haydovchi safarni faqat yo'lovchi belgilagan manzilga shu masofada (metr) yetib kelganda yakunlay oladi
FINISH_RADIUS_M=200
# (eski versiyadan qolgan "yo'lovchi tasdig'i kutilmoqda" safarlarni avtomatik yopish, daqiqa)
FINISH_CONFIRM_TIMEOUT_MIN=10
NO_SHOW_WAIT_MIN=5
# "Haydovchi yaqinlashmoqda" xabari (metr)
NEAR_NOTIFY_RADIUS_M=400
# GPS bo'yicha avtomatik "Yetib keldim" (metr, 0 = o'chirilgan)
AUTO_ARRIVE_RADIUS_M=70


# --- Aloqa (kompaniya raqami orqali, raqamlar yashirin) ---------------
# none | operator | zadarma | webhook
CALL_PROVIDER=operator
# Zadarma: callback — avval tugmani bosganga, keyin ikkinchi tomonga kompaniya raqamidan qo'ng'iroq
# ZADARMA_KEY=
# ZADARMA_SECRET=
# ZADARMA_SIP=100
# O'z ATS (Asterisk, OnlinePBX...) uchun: {"order_id","first","second"} JSON POST qilinadi
# CALL_WEBHOOK_URL=https://pbx.example.uz/callback
# CALL_WEBHOOK_SECRET=

# --- Balansni to'ldirish ----------------------------------------------
# @BotFather -> Payments -> Click yoki Payme -> provider token (haydovchi botiga)
# PAYMENT_PROVIDER_TOKEN=
TOPUP_AMOUNTS=20000,50000,100000
PAYMENT_INSTRUCTIONS=Balansni to'ldirish uchun operatorga murojaat qiling va ID raqamingizni yuboring.

# --- Interfeys --------------------------------------------------------
# Rich Message kartalari (xarita bloki bilan); eski ilovalar uchun avtomatik zaxira
RICH_MESSAGES=true
# safar yakunida 🎉 effekti
MESSAGE_EFFECTS=true
# Tugmalarda custom emoji (bot egasida Telegram Premium bo'lishi kerak):
# BUTTON_EMOJI_IDS={"taxi": "5368324170671202286", "pin": "5391032818111363540"}

# --- Telegram ilovasi (Mini App) --------------------------------------
# Ilova HTTPS manzilda ochiladi. Kompyuterda: cloudflared bo'lsa tunnel o'zi ochiladi (start.bat yuklab oladi).
WEBAPP_ENABLED=true
WEBAPP_PORT=8081
# Doimiy domeningiz bo'lsa (masalan https://taxi.example.uz) — shu yerga yozing, tunnel kerak bo'lmaydi
WEBAPP_URL=
# auto — cloudflared (zaxira: ssh orqali localhost.run) bilan tunnel fonda ochiladi; none — o'chirilgan
WEBAPP_TUNNEL=auto
# Xarita tayllari va manzil qidiruvi (OpenStreetMap)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRY=uz

# --- Admin web-panel: brauzerda http://localhost:8080 ----------------
ADMIN_PANEL_ENABLED=true
ADMIN_PANEL_PORT=8080
# Bo'sh bo'lsa parol avtomatik yaratiladi va ishga tushganda ko'rsatiladi (data/admin_panel_password.txt)
ADMIN_PANEL_PASSWORD=

LOG_LEVEL=INFO
